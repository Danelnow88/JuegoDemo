<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Enemy Visual Lab — Haunted Ghost</title>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    html,body {
      margin:0; height:100%;
      font-family:system-ui,-apple-system,Segoe UI,sans-serif;
      color:#e9f7ff; background:#07080d; overflow:hidden;
    }
    body { display:grid; grid-template-rows:auto 1fr; }
    .tools {
      display:flex; flex-wrap:wrap; gap:8px; align-items:center;
      padding:8px 12px; background:rgba(0,0,0,.72);
      border-bottom:1px solid #262a37; font-size:13px; z-index:10;
    }
    .tools fieldset {
      border:1px solid #41495f; border-radius:7px;
      padding:6px 10px; margin:0;
    }
    .tools legend { color:#a9b9ff; font-size:11px; padding:0 5px; }
    .tools button {
      background:#171b28; color:#dce7ff; border:1px solid #505c79;
      border-radius:5px; padding:4px 9px; cursor:pointer; font-size:12px;
    }
    .tools button.active { background:#70202a; border-color:#ff455a; color:white; }
    .tools input[type=range] { width:120px; accent-color:#ff314b; }
    .stat {
      background:#10131c; color:#f2ccd2; padding:2px 7px;
      border-radius:4px; font-family:ui-monospace,SFMono-Regular,Consolas,monospace;
    }
    .stage {
      position:relative; width:100%; height:100%;
      background:
        radial-gradient(circle at 50% 48%, rgba(72,0,10,.18), transparent 35%),
        linear-gradient(#090a0f,#030306);
      overflow:hidden;
    }
    canvas { position:absolute; inset:0; width:100%; height:100%; display:block; }
    .note {
      position:fixed; right:10px; bottom:8px;
      font-size:11px; color:#9ba4bd; pointer-events:none;
    }
  </style>
</head>
<body>
  <div class="tools">
    <fieldset>
      <legend>MODE</legend>
      <button data-mode="focus" class="active">Focus</button>
      <button data-mode="swarm">Swarm</button>
      <button data-mode="sheet">Pose sheet</button>
    </fieldset>

    <fieldset>
      <legend>POSE</legend>
      <button data-pose="0" class="active">1</button>
      <button data-pose="1">2</button>
      <button data-pose="2">3</button>
      <button data-pose="3">4</button>
      <button data-pose="4">5</button>
      <button data-pose="5">6</button>
    </fieldset>

    <fieldset>
      <legend>ANIMATION</legend>
      <button id="anim" class="active">ON</button>
      <button id="eyes" class="active">Eyes track</button>
      <button id="glow" class="active">Red glow</button>
    </fieldset>

    <fieldset>
      <legend>SCALE</legend>
      <input id="scale" type="range" min="0.45" max="1.80" step="0.01" value="1">
      <span class="stat" id="scaleVal">1.00</span>
    </fieldset>

    <fieldset>
      <legend>RAGE</legend>
      <input id="rage" type="range" min="0" max="1" step="0.01" value="0.75">
      <span class="stat" id="rageVal">0.75</span>
    </fieldset>

    <span class="stat" id="fps">FPS --</span>
    <span class="stat" id="count">Entities: 1</span>
  </div>

  <div class="stage">
    <canvas id="game" width="1100" height="680"></canvas>
  </div>

  <div class="note">PoC visual aislado — espectro refinado: seis variantes distintas de ojos-runa + cola viva y aura espectral.</div>

<script>
(() => {
  const canvas = document.getElementById('game');
  const ctx = canvas.getContext('2d');

  const S = {
    mode: 'focus',
    pose: 0,
    anim: true,
    eyeTrack: true,
    glow: true,
    scale: 1,
    rage: .75,
    mouse: {x:550,y:340},
    t: 0,
    entities: []
  };

  const POSES = [
    { body:[1.00,.96], tilt:-.10, head:1.00, mouth:0, eye:.92, eyeStyle:0, tailLen:1.00, tailDir:-1, tailAmp:.54, eyeAng:.03, eyeSep:22, eyeY:-31, mouthY:7 },
    { body:[.94,1.00], tilt:.08,  head:.94, mouth:1, eye:.86, eyeStyle:1, tailLen:.96, tailDir: 1, tailAmp:.42, eyeAng:.02, eyeSep:21, eyeY:-30, mouthY:6 },
    { body:[1.04,.98], tilt:.05,  head:1.02, mouth:0, eye:.96, eyeStyle:2, tailLen:1.06, tailDir: 1, tailAmp:.58, eyeAng:.02, eyeSep:23, eyeY:-32, mouthY:8 },
    { body:[1.06,.96], tilt:-.16, head:1.04, mouth:2, eye:.90, eyeStyle:3, tailLen:.98, tailDir:-1, tailAmp:.50, eyeAng:.03, eyeSep:22, eyeY:-30, mouthY:7 },
    { body:[.98,1.04], tilt:.14,  head:.96, mouth:3, eye:.88, eyeStyle:4, tailLen:1.02, tailDir: 1, tailAmp:.46, eyeAng:.02, eyeSep:21, eyeY:-29, mouthY:8 },
    { body:[1.05,.95], tilt:-.03, head:1.05, mouth:1, eye:.94, eyeStyle:5, tailLen:1.10, tailDir:-1, tailAmp:.60, eyeAng:.03, eyeSep:23, eyeY:-31, mouthY:6 }
  ];

  function resize() {
    const r = canvas.getBoundingClientRect();
    const dpr = Math.min(devicePixelRatio || 1, 2);
    canvas.width = Math.max(1, Math.round(r.width*dpr));
    canvas.height = Math.max(1, Math.round(r.height*dpr));
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  addEventListener('resize', resize); resize();

  function path(points) {
    ctx.beginPath();
    for (const cmd of points) {
      if (cmd[0]==='M') ctx.moveTo(cmd[1],cmd[2]);
      else if (cmd[0]==='L') ctx.lineTo(cmd[1],cmd[2]);
      else if (cmd[0]==='C') ctx.bezierCurveTo(cmd[1],cmd[2],cmd[3],cmd[4],cmd[5],cmd[6]);
      else if (cmd[0]==='Q') ctx.quadraticCurveTo(cmd[1],cmd[2],cmd[3],cmd[4]);
      else if (cmd[0]==='Z') ctx.closePath();
    }
  }

  function blobShadow(x,y,r,a=.18) {
    const g = ctx.createRadialGradient(x,y,0,x,y,r);
    g.addColorStop(0,`rgba(255,0,32,${a})`);
    g.addColorStop(1,'rgba(255,0,32,0)');
    ctx.fillStyle=g; ctx.beginPath(); ctx.arc(x,y,r,0,Math.PI*2); ctx.fill();
  }

  function drawEye(cx, cy, side, rage, lookX, lookY, eyeScale, extraAngle=0, eyeStyle=0) {
    const lx = Math.max(-1.6, Math.min(1.6, lookX*0.006));
    const ly = Math.max(-1.2, Math.min(1.2, lookY*0.005));

    ctx.save();
    ctx.translate(cx + lx, cy + ly);
    ctx.rotate(side*(0.055 + rage*.028) + extraAngle*.18);

    if (S.glow) blobShadow(0,0,30*eyeScale,.29);

    ctx.save();
    ctx.shadowColor='rgba(255,0,28,.85)';
    ctx.shadowBlur=10*eyeScale;
    ctx.fillStyle='#ff1024';
    ctx.strokeStyle='#ff1024';
    ctx.lineJoin='miter';
    ctx.lineCap='round';

    const sx=10.5*eyeScale;
    const sy=18.5*eyeScale;

    ctx.beginPath();

    switch (eyeStyle % 6) {
      case 0:
        // 1 — Rune star: tu primer boceto verde, cuatro puntas.
        ctx.moveTo(0,-sy);
        ctx.lineTo( sx*.23,-sy*.30);
        ctx.lineTo( sx,0);
        ctx.lineTo( sx*.23, sy*.30);
        ctx.lineTo(0,sy);
        ctx.lineTo(-sx*.23, sy*.30);
        ctx.lineTo(-sx,0);
        ctx.lineTo(-sx*.23,-sy*.30);
        ctx.closePath();
        ctx.fill();
        break;

      case 1:
        // 2 — Spear eye: más vertical, como una lanza/aguja maldita.
        ctx.moveTo(0,-sy*1.08);
        ctx.lineTo( sx*.32,-sy*.18);
        ctx.lineTo( sx*.82, sy*.02);
        ctx.lineTo( sx*.30, sy*.18);
        ctx.lineTo(0, sy*1.02);
        ctx.lineTo(-sx*.18, sy*.22);
        ctx.lineTo(-sx*.72,0);
        ctx.lineTo(-sx*.20,-sy*.22);
        ctx.closePath();
        ctx.fill();
        break;

      case 2:
        // 3 — Broken diamond: rombo agresivo con cintura muy cerrada.
        ctx.moveTo(0,-sy*.92);
        ctx.lineTo( sx*.88,-sy*.10);
        ctx.lineTo( sx*.30,0);
        ctx.lineTo( sx*.92, sy*.18);
        ctx.lineTo(0, sy*.92);
        ctx.lineTo(-sx*.88, sy*.15);
        ctx.lineTo(-sx*.30,0);
        ctx.lineTo(-sx*.88,-sy*.12);
        ctx.closePath();
        ctx.fill();
        break;

      case 3:
        // 4 — Crooked star: estrella torcida/asimétrica, más demoníaca.
        ctx.moveTo(-sx*.10,-sy);
        ctx.lineTo( sx*.20,-sy*.28);
        ctx.lineTo( sx*1.05,-sy*.08);
        ctx.lineTo( sx*.32, sy*.22);
        ctx.lineTo( sx*.10, sy);
        ctx.lineTo(-sx*.18, sy*.26);
        ctx.lineTo(-sx*.92, sy*.04);
        ctx.lineTo(-sx*.28,-sy*.20);
        ctx.closePath();
        ctx.fill();
        break;

      case 4:
        // 5 — Forked eye: centro filoso con una pequeña bifurcación lateral.
        ctx.moveTo(0,-sy);
        ctx.lineTo( sx*.22,-sy*.26);
        ctx.lineTo( sx*.92,-sy*.04);
        ctx.lineTo( sx*.38, sy*.10);
        ctx.lineTo( sx*.68, sy*.42);
        ctx.lineTo(0, sy*.98);
        ctx.lineTo(-sx*.18, sy*.28);
        ctx.lineTo(-sx*.92,0);
        ctx.lineTo(-sx*.24,-sy*.22);
        ctx.closePath();
        ctx.fill();
        break;

      case 5:
        // 6 — Hourglass blade: dos puntas verticales + cintura agresiva.
        ctx.moveTo(0,-sy);
        ctx.lineTo( sx*.72,-sy*.22);
        ctx.lineTo( sx*.22,0);
        ctx.lineTo( sx*.78, sy*.18);
        ctx.lineTo(0, sy);
        ctx.lineTo(-sx*.78, sy*.18);
        ctx.lineTo(-sx*.22,0);
        ctx.lineTo(-sx*.72,-sy*.22);
        ctx.closePath();
        ctx.fill();
        break;
    }

    ctx.restore();

    // Núcleo negro: cambia un poco según estilo para que no parezcan clones.
    ctx.fillStyle='rgba(0,0,0,.82)';
    ctx.beginPath();

    switch (eyeStyle % 6) {
      case 0:
        ctx.moveTo(0,-sy*.40);
        ctx.lineTo(sx*.14,0);
        ctx.lineTo(0,sy*.40);
        ctx.lineTo(-sx*.14,0);
        break;
      case 1:
        ctx.moveTo(0,-sy*.52);
        ctx.lineTo(sx*.10,0);
        ctx.lineTo(0,sy*.50);
        ctx.lineTo(-sx*.10,0);
        break;
      case 2:
        ctx.moveTo(0,-sy*.32);
        ctx.lineTo(sx*.22,0);
        ctx.lineTo(0,sy*.32);
        ctx.lineTo(-sx*.22,0);
        break;
      case 3:
        ctx.moveTo(-sx*.04,-sy*.38);
        ctx.lineTo(sx*.18,0);
        ctx.lineTo(sx*.03,sy*.40);
        ctx.lineTo(-sx*.16,0);
        break;
      case 4:
        ctx.moveTo(0,-sy*.42);
        ctx.lineTo(sx*.12,-sy*.02);
        ctx.lineTo(-sx*.03,sy*.43);
        ctx.lineTo(-sx*.14,0);
        break;
      case 5:
        ctx.moveTo(0,-sy*.38);
        ctx.lineTo(sx*.20,0);
        ctx.lineTo(0,sy*.38);
        ctx.lineTo(-sx*.20,0);
        break;
    }

    ctx.closePath();
    ctx.fill();

    // Centro encendido diminuto.
    ctx.fillStyle='rgba(255,135,145,.78)';
    ctx.beginPath();
    ctx.arc(0,0,1.25*eyeScale,0,Math.PI*2);
    ctx.fill();

    ctx.restore();
  }

  function drawMouth(type, y, rage) {
    ctx.save();
    ctx.translate(0,y);

    if (S.glow) blobShadow(0,2,36,.20);

    if (type===2 || type===3) {
      // Boca de grito más macabra, menos "óvalo perfecto".
      const w = type===3 ? 17 : 14;
      const h = type===3 ? 24 : 20;
      ctx.fillStyle='#ff111c';
      ctx.beginPath();
      ctx.moveTo(0,-h);
      ctx.bezierCurveTo(w*.95,-h*.82, w*1.05,h*.15,  w*.20,h);
      ctx.bezierCurveTo(w*.06,h*1.04, -w*.08,h*1.04, -w*.24,h);
      ctx.bezierCurveTo(-w*1.06,h*.10, -w*.94,-h*.82, 0,-h);
      ctx.closePath();
      ctx.fill();

      // Recorte interior sutil para dar más profundidad.
      ctx.fillStyle='rgba(120,0,8,.38)';
      ctx.beginPath();
      ctx.moveTo(0,-h*.56);
      ctx.bezierCurveTo(w*.42,-h*.42, w*.50,h*.04,  w*.12,h*.52);
      ctx.bezierCurveTo(0,h*.60, -w*.14,h*.58, -w*.20,h*.52);
      ctx.bezierCurveTo(-w*.52,h*.04, -w*.44,-h*.42, 0,-h*.56);
      ctx.closePath();
      ctx.fill();

      return ctx.restore();
    }

    // Boca dentada más filosa y macabra, manteniendo el estilo cartoon.
    ctx.fillStyle='#ff111c';
    ctx.beginPath();
    ctx.moveTo(-30,-8);
    ctx.lineTo(-22,2);
    ctx.lineTo(-15,-6);
    ctx.lineTo(-7,6);
    ctx.lineTo(1,-4);
    ctx.lineTo(9,7);
    ctx.lineTo(17,-4);
    ctx.lineTo(24,4);
    ctx.lineTo(31,-8);
    ctx.lineTo(28,10);
    ctx.lineTo(20,3);
    ctx.lineTo(12,14);
    ctx.lineTo(3,5);
    ctx.lineTo(-6,15);
    ctx.lineTo(-14,4);
    ctx.lineTo(-23,13);
    ctx.closePath();
    ctx.fill();

    if (type===1) {
      // segunda hilera / gesto aún más cruel
      ctx.globalAlpha=.94;
      ctx.beginPath();
      ctx.moveTo(-20,-12); ctx.lineTo(-12,-2); ctx.lineTo(-4,-13);
      ctx.lineTo(3,-2); ctx.lineTo(11,-12); ctx.lineTo(18,-2);
      ctx.lineTo(24,-13); ctx.lineTo(23,-1); ctx.lineTo(15,6);
      ctx.lineTo(8,-3); ctx.lineTo(0,7); ctx.lineTo(-8,-3);
      ctx.lineTo(-16,6); ctx.closePath(); ctx.fill();
    }
    ctx.restore();
  }

  // Cola integrada al cuerpo.
  // La animación usa una onda viajera continua y muchas muestras para que el
  // movimiento se vea vivo incluso en monitores de alta frecuencia.
  // La raíz permanece estable; desde un poco debajo de mitad del torso,
  // la amplitud aumenta progresivamente hacia la punta.
  function buildTailRibbon(startX, startY, p, t, seed) {
    const dir = p.tailDir || 1;
    const amp = 31 * (p.tailAmp || .5);
    const len = 122 * (p.tailLen || 1);

    const centers = [];
    const left = [];
    const right = [];

    // Más resolución geométrica = curva más limpia durante el movimiento.
    const samples = 88;

    const smoothstep = x => {
      x = Math.max(0, Math.min(1, x));
      return x*x*(3-2*x);
    };

    // Base S estática + onda viajera superpuesta.
    for (let i=0; i<=samples; i++) {
      const u = i/samples;

      // Taper de activación: prácticamente inmóvil al nacer del torso.
      // El movimiento empieza suave y toma fuerza hacia el último 70%.
      const motion = smoothstep((u - .10) / .90);

      // Curva base S muy suave.
      const baseS =
        dir * amp * (
          .33*Math.sin(u*Math.PI*1.18) -
          .23*Math.sin(u*Math.PI*2.05)
        );

      // Onda principal viajera: sensación de serpenteo continuo.
      const waveA = Math.sin(t*5.4 - u*8.2 + seed);

      // Segunda onda más corta para evitar movimiento mecánico/repetitivo.
      const waveB = Math.sin(t*8.6 - u*13.4 + seed*1.37);

      // Tercera micro-onda casi imperceptible para "vida" en la punta.
      const waveC = Math.sin(t*12.2 - u*18.0 + seed*.73);

      const liveWave =
        motion * (
          waveA * (3.0 + 6.5*u) +
          waveB * (1.0 + 2.4*u) +
          waveC * (0.25 + 0.9*u)
        );

      const x = startX + baseS + liveWave;
      const y = startY + len*u;

      centers.push([x,y]);
    }

    // Construir la cinta alrededor de la curva central.
    for (let i=0; i<=samples; i++) {
      const u = i/samples;
      const prev = centers[Math.max(0,i-1)];
      const next = centers[Math.min(samples,i+1)];

      const dx = next[0]-prev[0];
      const dy = next[1]-prev[1];
      const mag = Math.hypot(dx,dy) || 1;
      const nx = -dy/mag;
      const ny = dx/mag;

      // El cuerpo se va afinando de forma progresiva hasta una única punta.
      const taper = smoothstep(u);
      const width = 27*(1-taper) + .48*taper;

      const x = centers[i][0];
      const y = centers[i][1];

      left.push([x + nx*width, y + ny*width]);
      right.push([x - nx*width, y - ny*width]);
    }

    return {left,right,centers};
  }

  // Resplandor rojo alrededor de la cola.
  // Se dibuja detrás de la silueta negra, así que solo queda visible como aura.
  function drawTailGlow(tail,t,seed) {
    if (!S.glow || !tail.centers || tail.centers.length < 2) return;

    const pts = tail.centers;
    const pulse = .78 + Math.sin(t*3.4 + seed)*.12;

    ctx.save();
    ctx.globalCompositeOperation='lighter';
    ctx.lineCap='round';
    ctx.lineJoin='round';

    const trace = () => {
      ctx.beginPath();
      ctx.moveTo(pts[0][0],pts[0][1]);
      for(let i=1;i<pts.length;i++) ctx.lineTo(pts[i][0],pts[i][1]);
    };

    // Halo exterior.
    ctx.strokeStyle=`rgba(255,18,35,${.055*pulse})`;
    ctx.lineWidth=28;
    ctx.shadowColor='rgba(255,0,28,.42)';
    ctx.shadowBlur=22;
    trace();
    ctx.stroke();

    // Halo medio.
    ctx.strokeStyle=`rgba(255,24,42,${.10*pulse})`;
    ctx.lineWidth=13;
    ctx.shadowColor='rgba(255,0,25,.52)';
    ctx.shadowBlur=12;
    trace();
    ctx.stroke();

    // Línea energética extremadamente sutil en el centro.
    ctx.strokeStyle=`rgba(255,45,55,${.12*pulse})`;
    ctx.lineWidth=2.2;
    ctx.shadowColor='rgba(255,15,30,.65)';
    ctx.shadowBlur=7;
    trace();
    ctx.stroke();

    ctx.restore();
  }

  function drawGhost(x,y,baseScale,poseIndex,t,seed=0) {
    const p = POSES[poseIndex % POSES.length];
    const bob   = S.anim ? (Math.sin(t*1.65 + seed)*6.5 + Math.sin(t*3.15 + seed*.4)*1.3) : 0;
    const sway  = S.anim ? (Math.sin(t*.95 + seed*.7)*.028 + Math.sin(t*2.4 + seed)*.008) : 0;
    const pulse = S.anim ? 1 + Math.sin(t*2.35 + seed)*.010 : 1;
    const sc = baseScale * S.scale * pulse;

    ctx.save();
    ctx.translate(x, y + bob);
    ctx.rotate(p.tilt + sway);
    ctx.scale(sc, sc);

    if (S.glow) blobShadow(0,10,92,.06);

    ctx.fillStyle = '#020203';
    ctx.strokeStyle = '#050507';
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';

    const bw = p.body[0];
    const bh = p.body[1];
    const head = p.head;

    // Raíz de cola alta y ancha: el torso ya empieza a afinarse antes de llegar acá.
    const tail = buildTailRibbon(0, 70*bh, p, t, seed);

    // Aura animada detrás de la cola.
    drawTailGlow(tail,t,seed);

    const L = tail.left;
    const R = tail.right;
    const tipL = L[L.length-1];
    const tipR = R[R.length-1];
    const tipX = (tipL[0]+tipR[0])/2;
    const tipY = (tipL[1]+tipR[1])/2;

    // UNA SOLA SILUETA:
    // cabeza -> hombros -> torso estrecho -> borde izq de cola -> punta
    // -> borde der de cola -> torso -> cabeza.
    ctx.beginPath();
    ctx.moveTo(-17*head,-71);

    // Cabeza redondeada / amenazante.
    ctx.bezierCurveTo(-44*bw,-70, -55*bw,-49, -54*bw,-23);
    ctx.bezierCurveTo(-53*bw,-4, -47*bw,15, -41*bw,30);

    // Lateral izquierdo limpio. SIN aletitas.
    ctx.bezierCurveTo(-37*bw,43, -31*bw,56, L[0][0],L[0][1]);

    // Borde izquierdo de la cola.
    for (let i=1;i<L.length;i++) {
      ctx.lineTo(L[i][0],L[i][1]);
    }

    // Punta única.
    ctx.lineTo(tipX,tipY);

    // Borde derecho de la cola.
    for (let i=R.length-2;i>=0;i--) {
      ctx.lineTo(R[i][0],R[i][1]);
    }

    // Lateral derecho del torso: mismo taper progresivo.
    ctx.bezierCurveTo(31*bw,56, 37*bw,43, 41*bw,30);
    ctx.bezierCurveTo(47*bw,15, 53*bw,-4, 54*bw,-23);

    // Cierre superior.
    ctx.bezierCurveTo(55*bw,-49, 44*bw,-70, 17*head,-72);
    ctx.bezierCurveTo(7,-74, -7,-74, -17*head,-71);
    ctx.closePath();
    ctx.fill();

    // Sombra interior muy sutil para que se lea el volumen sin inflar la forma.
    ctx.save();
    ctx.globalAlpha=.10;
    const shade = ctx.createLinearGradient(-30,-10,30,90);
    shade.addColorStop(0,'rgba(255,255,255,.18)');
    shade.addColorStop(.45,'rgba(255,255,255,.04)');
    shade.addColorStop(1,'rgba(255,255,255,0)');
    ctx.strokeStyle=shade;
    ctx.lineWidth=1.2;
    ctx.beginPath();
    ctx.moveTo(-30,-18);
    ctx.bezierCurveTo(-26,20,-19,47,-11,74);
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(28,-18);
    ctx.bezierCurveTo(24,18,18,44,10,72);
    ctx.stroke();
    ctx.restore();

    // Cara.
    const lookX = S.eyeTrack ? (S.mouse.x - x) : 0;
    const lookY = S.eyeTrack ? (S.mouse.y - y) : 0;
    drawEye(-(p.eyeSep||24), p.eyeY||-30, -1, S.rage, lookX, lookY, p.eye, -(p.eyeAng||0), p.eyeStyle||0);
    drawEye( +(p.eyeSep||24), p.eyeY||-30,  1, S.rage, lookX, lookY, p.eye, +(p.eyeAng||0), p.eyeStyle||0);
    drawMouth(p.mouth, p.mouthY||6, S.rage);

    ctx.restore();
  }

  function drawSheet(w,h,t) {
    const pts=[
      [w*.20,h*.28,.78,1],
      [w*.48,h*.22,.60,2],
      [w*.76,h*.30,.86,0],
      [w*.25,h*.68,.72,3],
      [w*.52,h*.68,.95,4],
      [w*.79,h*.70,.82,5]
    ];
    pts.forEach((a,i)=>drawGhost(a[0],a[1],a[2],a[3],t,i*.9));
    document.getElementById('count').textContent='Entities: 6';
  }

  function drawSwarm(w,h,t) {
    const pts=[
      [.12,.22,.36,1],[.26,.39,.45,3],[.42,.18,.32,0],[.57,.46,.52,2],
      [.74,.24,.38,4],[.88,.43,.44,5],[.19,.75,.40,5],[.40,.69,.31,1],
      [.64,.76,.46,0],[.83,.73,.35,3],[.52,.83,.26,2],[.07,.54,.27,4]
    ];
    pts.forEach((a,i)=>drawGhost(w*a[0],h*a[1],a[2],a[3],t,i*1.73));
    document.getElementById('count').textContent='Entities: '+pts.length;
  }

  function render(now) {
    const r=canvas.getBoundingClientRect();
    const w=r.width,h=r.height;
    ctx.clearRect(0,0,w,h);
    S.t = S.anim ? now/1000 : S.t;

    // viñeta
    const vg=ctx.createRadialGradient(w/2,h/2,60,w/2,h/2,Math.max(w,h)*.75);
    vg.addColorStop(0,'rgba(255,255,255,0)');
    vg.addColorStop(1,'rgba(0,0,0,.5)');
    ctx.fillStyle=vg; ctx.fillRect(0,0,w,h);

    if(S.mode==='sheet') drawSheet(w,h,S.t);
    else if(S.mode==='swarm') drawSwarm(w,h,S.t);
    else {
      drawGhost(w/2,h/2-5,1.18,S.pose,S.t,.2);
      document.getElementById('count').textContent='Entities: 1';
    }

    requestAnimationFrame(render);
  }

  canvas.addEventListener('pointermove',e=>{
    const r=canvas.getBoundingClientRect();
    S.mouse.x=e.clientX-r.left; S.mouse.y=e.clientY-r.top;
  });

  document.querySelectorAll('[data-mode]').forEach(b=>b.onclick=()=>{
    S.mode=b.dataset.mode;
    document.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('active',x===b));
  });

  document.querySelectorAll('[data-pose]').forEach(b=>b.onclick=()=>{
    S.pose=+b.dataset.pose;
    S.mode='focus';
    document.querySelectorAll('[data-mode]').forEach(x=>x.classList.toggle('active',x.dataset.mode==='focus'));
    document.querySelectorAll('[data-pose]').forEach(x=>x.classList.toggle('active',x===b));
  });

  document.getElementById('anim').onclick=e=>{
    S.anim=!S.anim; e.currentTarget.classList.toggle('active',S.anim);
    e.currentTarget.textContent=S.anim?'ON':'PAUSE';
  };
  document.getElementById('eyes').onclick=e=>{
    S.eyeTrack=!S.eyeTrack; e.currentTarget.classList.toggle('active',S.eyeTrack);
  };
  document.getElementById('glow').onclick=e=>{
    S.glow=!S.glow; e.currentTarget.classList.toggle('active',S.glow);
  };

  document.getElementById('scale').oninput=e=>{
    S.scale=+e.target.value;
    document.getElementById('scaleVal').textContent=S.scale.toFixed(2);
  };
  document.getElementById('rage').oninput=e=>{
    S.rage=+e.target.value;
    document.getElementById('rageVal').textContent=S.rage.toFixed(2);
  };

  let last=performance.now(),frames=0,fps=0;
  setInterval(()=>{
    const now=performance.now(),dt=now-last;
    fps=Math.round(frames*1000/dt); frames=0; last=now;
    document.getElementById('fps').textContent='FPS '+fps;
  },500);
  (function countLoop(){frames++; requestAnimationFrame(countLoop)})();

  requestAnimationFrame(render);
})();
</script>
</body>
</html>